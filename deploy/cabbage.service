[Unit]
Description=Cabbage Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cabbage
Group=cabbage
WorkingDirectory=/opt/cabbage
ExecStart=/opt/cabbage/cabbage --data /opt/cabbage/data --addr :5700
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Environment=TZ=Asia/Shanghai
Environment=PYTHONUTF8=1

[Install]
WantedBy=multi-user.target
