[Unit]
Description=Cabbage Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cabbage
Group=cabbage
WorkingDirectory=/opt/cabbage
ExecStart=/opt/cabbage/cabbage --data /opt/cabbage/data --addr :5700
# 在线更新：面板就地替换程序后退出，需 Restart=always 才能自动拉起新版本。
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Environment=TZ=Asia/Shanghai
Environment=PYTHONUTF8=1

[Install]
WantedBy=multi-user.target
