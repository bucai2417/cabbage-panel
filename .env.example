# 复制为 .env 后按需覆盖：cp .env.example .env
# docker compose 会自动读取 .env；.env 已在 .gitignore 中，不会提交。
# 绝大多数情况不需要这个文件——所有参数都有自动默认值。

# 运行身份：默认自动跟随数据目录的宿主机属主，无需配置。
# 只有想强制指定某个 uid/gid 时才取消注释：
# PUID=1026
# PGID=100

# 源码优先取自构建上下文；不完整时回退从 GitHub 下载，以下是回退参数。
# SOURCE_REPO=bucai2417/cabbage-panel
# SOURCE_REF=main

# 基础镜像仓库前缀。默认已内置 docker.1ms.run/ 加速站。
# 换站示例：DOCKER_MIRROR=docker.m.daocloud.io/library/
# 显式设为空值则直连 Docker Hub。
# DOCKER_MIRROR=docker.1ms.run/

# Node / Go 工具链：默认从国内镜像下二进制，不走官方镜像。
# NODE_VERSION=24.22.3
# GO_VERSION=1.27.4
# NODE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release
# GO_MIRROR=https://mirrors.aliyun.com/golang

# 依赖源默认由 Dockerfile 内置国内镜像；境外网络可覆盖为官方源。
# NPM_REGISTRY=https://registry.npmjs.org
# GOPROXY=https://proxy.golang.org,direct
# DEBIAN_MIRROR=http://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=http://security.debian.org/debian-security

# 运行时 Python 版本：3.10 / 3.11 / 3.12
# PYTHON_VERSION=3.10
