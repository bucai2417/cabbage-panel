# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取 .env；.env 已在 .gitignore 中，不会提交。

# 基础镜像仓库前缀。国内拉取 Docker Hub 很慢时设为加速站：
#   DOCKER_MIRROR=docker.1ms.run/
#   DOCKER_MIRROR=docker.m.daocloud.io/library/
# 留空或删除此行则使用 Docker Hub 官方镜像名。
DOCKER_MIRROR=

# 依赖源，默认已在 Dockerfile 内置国内镜像；境外网络可覆盖为官方源。
# NPM_REGISTRY=https://registry.npmmirror.com
# GOPROXY=https://goproxy.cn,direct
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# 运行时 Python 版本（3.10 / 3.11 / 3.12）
# PYTHON_VERSION=3.10
